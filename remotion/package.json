{
  "name": "jillmar-remotion",
  "private": true,
  "version": "1.0.0",
  "description": "Starter Remotion project, rendered on AWS Lambda",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render Intro out/intro.mp4",
